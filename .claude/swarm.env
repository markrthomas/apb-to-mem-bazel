# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=apb-to-mem-bazel
GH_REPO=markrthomas/apb-to-mem-bazel
DUT_TOP=apb_mem

RTL_DIR=rtl
TB_DIR=tb

DV_ENVS="sim cocotb uvm"
GATE_TARGET=check
CI_TARGET=ci
CROSSCHECK_TARGET=
INFRA_TARGETS="formal lp"
HEAVY_TARGETS="uvm formal ci"

MUTATION_FILE=rtl/apb_mem.sv
MUTATION_HINT="invert one valid/ready qualifier or corrupt one data bit on the main datapath"

RR_DIR=tb/random
RR_STATUS=bootstrap

METRICS=no
